<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InToolz.Utilities.SelectionActionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Shared bottom action-bar chrome: a live count label plus a content slot for
        page-specific action buttons (Renaming's Update button; Assign/Remove/Delete/
        Export on later pages). Holds no business logic of its own — same "fires events,
        holds no state" convention as SearchStagingBar, except here the host supplies
        finished buttons via ExtraButtons rather than the control raising click events,
        since the action set genuinely differs per page.

        Drop at the bottom of a page's root Grid (its own row, spanning the full width):
            <utilities:SelectionActionBar x:Name="RenameActionBar">
                <utilities:SelectionActionBar.ExtraButtons>
                    <Button .../>
                </utilities:SelectionActionBar.ExtraButtons>
            </utilities:SelectionActionBar>
    -->
    <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock x:Name="CountTextBlock" Text="0 staged" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ContentPresenter x:Name="ExtraButtonsPresenter" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
