<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IntuneTools.Utilities.SearchStagingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Shared "Search & Staging" toolbar cluster used by every data-operation page
        (Renaming, Cleanup's Delete panel, Manage Assignments, Import, JSON). See
        docs/UI_STANDARD.md. Drop into a page's toolbar card with:
            <utilities:SearchStagingBar x:Name="SearchStagingBar"
                                         SearchRequested="..."
                                         ListAllRequested="..."
                                         ClearSelectedRequested="..."
                                         ClearAllRequested="..."
                                         ClearLogRequested="ClearLogButton_Click"
                                         ExportCsvRequested="..."/>
        Pages that need one more page-specific verb between "List All" and the
        "Clear Selected" group (Cleanup's "Find Unassigned", Import's "Content Types"
        flyout) set the ExtraButtons property to a StackPanel containing it.
    -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox x:Name="SearchQueryTextBox"
                 PlaceholderText="Enter search query..."
                 Width="250"
                 VerticalAlignment="Center"
                 KeyDown="SearchQueryTextBox_KeyDown"/>
        <AppBarButton x:Name="SearchButton" Icon="Find" Label="Search" Click="SearchButton_Click" ToolTipService.ToolTip="Search for specific items."/>
        <AppBarButton x:Name="ListAllButton" Icon="ViewAll" Label="List All" Click="ListAllButton_Click" ToolTipService.ToolTip="List all items."/>
        <ContentPresenter x:Name="ExtraButtonsPresenter"/>
        <AppBarSeparator/>
        <AppBarButton x:Name="ClearSelectedButton" Icon="Remove" Label="Clear Selected" Click="ClearSelectedButton_Click" ToolTipService.ToolTip="Remove selected items from staging area."/>
        <AppBarButton x:Name="ClearAllButton" Icon="Clear" Label="Clear All" Click="ClearAllButton_Click" ToolTipService.ToolTip="Clear all items from staging area."/>
        <AppBarSeparator/>
        <AppBarButton x:Name="ClearLogButton" Icon="Delete" Label="Clear Log" Click="ClearLogButton_Click" ToolTipService.ToolTip="Clear the log console."/>
        <AppBarSeparator/>
        <AppBarButton x:Name="ExportCsvButton" Icon="Save" Label="Export CSV" Click="ExportCsvButton_Click" ToolTipService.ToolTip="Export the current list to a CSV file."/>
    </StackPanel>
</UserControl>
