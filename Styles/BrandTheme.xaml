<?xml version="1.0" encoding="utf-8"?>
<!--
    InToolz 2.0 "Command Center" brand theme.

    Merged into App.xaml AFTER Styles/PageStyles.xaml, so these resources win over the
    default XamlControlsResources values for the same keys (last-merged wins). Every key
    overridden here is a key pages already reference via {ThemeResource ...} — see
    Styles/PageStyles.xaml — so no page XAML needs to change for the new palette to apply.

    Deliberately scoped: this overrides the brand accent plus the handful of surface/text
    tokens the app's own styles consume (card background/border, primary/secondary text,
    the critical/destructive fill, and the page background). It does NOT attempt to
    re-theme every deep Fluent system brush (TextBox/ComboBox/ContentDialog chrome, etc.),
    which keep the stock Fluent look for now — re-theming those is a much larger, riskier
    change than Phase 1 of the 2.0 rewrite calls for.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Brand accent =====
         Same six colors regardless of the active theme — WinUI's own control templates
         already pick the Light1-3 vs Dark1-3 variant appropriately per theme, so these are
         intentionally flat (outside ThemeDictionaries), matching how Windows itself injects
         the user's accent color. -->
    <Color x:Key="SystemAccentColor">#7C6CF6</Color>
    <Color x:Key="SystemAccentColorLight1">#9585F8</Color>
    <Color x:Key="SystemAccentColorLight2">#AE9FFA</Color>
    <Color x:Key="SystemAccentColorLight3">#C7B9FC</Color>
    <Color x:Key="SystemAccentColorDark1">#6A5AEB</Color>
    <Color x:Key="SystemAccentColorDark2">#5848D1</Color>
    <Color x:Key="SystemAccentColorDark3">#4636B7</Color>

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===== Dark ===== -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1B1B22"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2A2A38"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3A3A4A"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F2F6"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A6A6B8"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F2495C"/>
        </ResourceDictionary>

        <!-- ===== Light =====
             No light palette exists in the design-concepts mockups (those are dark-only) —
             these are new values, derived to pair with the same brand accent on white
             surfaces while keeping comfortable contrast. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F7F7FB"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E3E1EC"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1B22"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B6B7D"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#D1293F"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
