<?xml version="1.0" encoding="utf-8"?>
<utilities:BaseDataOperationPage
    x:Class="IntuneTools.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IntuneTools.Pages"
    xmlns:utilities="using:IntuneTools.Utilities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="{StaticResource PageRootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderBottomMargin}">
            <TextBlock Text="Intune Cleanup"
                       Style="{StaticResource PageTitleTextBlockStyle}"/>
            <TextBlock Text="Bulk delete policies and configurations from a tenant."
                       Style="{StaticResource PageSubtitleTextBlockStyle}"/>
            <InfoBar x:Name="TenantInfoBar"
                     Severity="Informational"
                     IsClosable="False"
                     IsOpen="False"
                     Margin="0,12,0,0"/>
            <utilities:OperationStatusBar x:Name="OperationStatusBar" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ===== Mode Selector ===== -->
        <ctk:Segmented Grid.Row="1"
                       x:Name="CleanupModeSegmented"
                       SelectionMode="Single"
                       SelectedIndex="0"
                       SelectionChanged="CleanupModeSegmented_SelectionChanged"
                       Margin="0,0,0,16">
            <ctk:SegmentedItem Content="Delete Content">
                <ctk:SegmentedItem.Icon>
                    <FontIcon Glyph="&#xE74D;"/>
                </ctk:SegmentedItem.Icon>
            </ctk:SegmentedItem>
            <ctk:SegmentedItem Content="Find Duplicates">
                <ctk:SegmentedItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </ctk:SegmentedItem.Icon>
            </ctk:SegmentedItem>
            <ctk:SegmentedItem Content="Stale Devices">
                <ctk:SegmentedItem.Icon>
                    <FontIcon Glyph="&#xE975;"/>
                </ctk:SegmentedItem.Icon>
            </ctk:SegmentedItem>
        </ctk:Segmented>

        <!-- ===== Main Content Row ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Delete or Duplicates -->
            <Grid Grid.Column="0">

                <!-- ── DELETE PANEL ── -->
                <Grid x:Name="DeletePanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource PageSectionSpacing}" Margin="0,0,0,16">

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Search &amp; Staging"
                                           Style="{StaticResource CardSectionLabelTextBlockStyle}"/>
                                <utilities:SearchStagingBar x:Name="SearchStagingBar"
                                                             SearchRequested="SearchStagingBar_SearchRequested"
                                                             ListAllRequested="ListAllButton_Click"
                                                             ClearSelectedRequested="ClearSelectedButton_Click"
                                                             ClearAllRequested="ClearAllButton_Click"
                                                             ClearLogRequested="ClearLogButton_Click"
                                                             ExportCsvRequested="ExportCsvButton_Click">
                                    <utilities:SearchStagingBar.ExtraButtons>
                                        <AppBarButton x:Name="FindUnassignedButton" Label="Find Unassigned" Click="FindUnassignedButton_Click" ToolTipService.ToolTip="Find content with no group assignments.">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE7B3;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                    </utilities:SearchStagingBar.ExtraButtons>
                                </utilities:SearchStagingBar>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Destructive Action"
                                           Style="{StaticResource CardSectionLabelTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="DeleteButton"
                                            Click="DeleteButton_Click"
                                            ToolTipService.ToolTip="Permanently delete all staged items."
                                            Style="{StaticResource DestructiveActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="White"/>
                                            <TextBlock Text="Delete All" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Staging InfoBar -->
                    <InfoBar Grid.Row="1"
                             IsOpen="True"
                             Severity="Warning"
                             Title="Staging Area"
                             Message="This grid acts as a staging area. All items listed below will be permanently deleted. Use the 'Clear' buttons to exclude items you do not wish to delete."
                             IsClosable="True"
                             Margin="0,0,12,12"/>

                    <!-- Cleanup DataGrid -->
                    <controls:DataGrid Grid.Row="2"
                                       x:Name="CleanupDataGrid"
                                       AutoGenerateColumns="False"
                                       SelectionMode="Extended"
                                       Margin="0,0,12,0"
                                       IsReadOnly="True"
                                       CanUserSortColumns="True"
                                       CanUserReorderColumns="False"
                                       Sorting="CleanupDataGrid_Sorting">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Name" Binding="{Binding ContentName}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="*"/>
                            <controls:DataGridTextColumn Header="Platform" Binding="{Binding ContentPlatform}" Width="*"/>
                            <controls:DataGridTextColumn Header="ID" Binding="{Binding ContentId}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Description" Binding="{Binding ContentDescription}" Width="3*"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <utilities:LoadingOverlay Grid.RowSpan="3" x:Name="LoadingOverlay"/>
                </Grid>

                <!-- ── DUPLICATES PANEL ── -->
                <Grid x:Name="DuplicatesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Duplicates Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource PageSectionSpacing}" Margin="0,0,0,16">

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scan &amp; Review"
                                           Style="{StaticResource CardSectionLabelTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <AppBarButton x:Name="ScanDuplicatesButton" Label="Scan" Click="ScanDuplicatesButton_Click" ToolTipService.ToolTip="Scan selected content types for duplicate names.">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE8C8;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton x:Name="ContentTypeFilterButton" Label="All Types" ToolTipService.ToolTip="Choose which content types to include in the scan.">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE71C;"/>
                                        </AppBarButton.Icon>
                                        <AppBarButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <ScrollViewer MaxHeight="350" MinWidth="220">
                                                    <StackPanel x:Name="ContentTypeFilterPanel" Spacing="6" Padding="4"/>
                                                </ScrollViewer>
                                            </Flyout>
                                        </AppBarButton.Flyout>
                                    </AppBarButton>
                                    <AppBarSeparator/>
                                    <AppBarButton x:Name="SelectOlderButton" Label="Select Older" Click="SelectOlderButton_Click" ToolTipService.ToolTip="Selects the older item in each duplicate pair. The newer item is kept.">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE8CB;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton x:Name="SelectUnassignedButton" Label="Select Unassigned" Click="SelectUnassignedButton_Click" ToolTipService.ToolTip="Selects unassigned items in groups where another item is assigned. Assigned items are kept.">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE7B3;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton x:Name="ClearDuplicateSelectionButton" Icon="Remove" Label="Clear Selected" Click="ClearDuplicateSelectionButton_Click" ToolTipService.ToolTip="Remove selected items from the results."/>
                                    <AppBarSeparator/>
                                    <AppBarButton x:Name="DuplicatesClearLogButton" Icon="Delete" Label="Clear Log" Click="ClearLogButton_Click" ToolTipService.ToolTip="Clear the log console."/>
                                    <AppBarSeparator/>
                                    <AppBarButton x:Name="DuplicatesExportCsvButton" Icon="Save" Label="Export CSV" Click="DuplicatesExportCsvButton_Click" ToolTipService.ToolTip="Export the duplicates list to a CSV file."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Destructive Action"
                                           Style="{StaticResource CardSectionLabelTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="DeleteDuplicatesButton"
                                            Click="DeleteDuplicatesButton_Click"
                                            ToolTipService.ToolTip="Permanently delete selected duplicates."
                                            Style="{StaticResource DestructiveActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="White"/>
                                            <TextBlock Text="Delete Selected" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Duplicates InfoBar -->
                    <InfoBar Grid.Row="1"
                             x:Name="DuplicatesInfoBar"
                             IsOpen="True"
                             Severity="Informational"
                             Title="Duplicate Detection"
                             Message="Scan to find policies with identical names. Use 'Select Older' or 'Select Unassigned' to mark items for deletion, then review and delete."
                             IsClosable="False"
                             Margin="0,0,12,12"/>

                    <!-- Duplicates DataGrid -->
                    <controls:DataGrid Grid.Row="2"
                                       x:Name="DuplicatesDataGrid"
                                       AutoGenerateColumns="False"
                                       SelectionMode="Extended"
                                       Margin="0,0,12,0"
                                       IsReadOnly="True"
                                       CanUserSortColumns="True"
                                       CanUserReorderColumns="False"
                                       Sorting="DuplicatesDataGrid_Sorting"
                                       LoadingRow="DuplicatesDataGrid_LoadingRow">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Name" Binding="{Binding ContentName}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="*"/>
                            <controls:DataGridTextColumn Header="Platform" Binding="{Binding ContentPlatform}" Width="*"/>
                            <controls:DataGridTextColumn Header="Created" Binding="{Binding CreatedDisplay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Assigned" Binding="{Binding AssignedDisplay}" Width="Auto"/>
                            <controls:DataGridTextColumn Header="ID" Binding="{Binding ContentId}" Width="2*"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <utilities:LoadingOverlay Grid.RowSpan="3" x:Name="DuplicatesLoadingOverlay"/>
                </Grid>

                <!-- ── STALE DEVICES PANEL ── -->
                <Grid x:Name="StaleDevicesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stale Devices Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource PageSectionSpacing}" Margin="0,0,0,16">

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scan"
                                           Style="{StaticResource CardSectionLabelTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <RadioButton x:Name="IntuneSourceRadio" Content="Intune Managed Devices" GroupName="StaleDeviceSource" IsChecked="True" Checked="StaleDeviceSource_Changed"/>
                                    <RadioButton x:Name="EntraSourceRadio" Content="Entra ID Devices" GroupName="StaleDeviceSource" Checked="StaleDeviceSource_Changed"/>
                                    <AppBarSeparator/>
                                    <TextBlock Text="Stale after:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="StaleThresholdComboBox" SelectedIndex="2" MinWidth="110">
                                        <ComboBoxItem Content="30 days" Tag="30"/>
                                        <ComboBoxItem Content="60 days" Tag="60"/>
                                        <ComboBoxItem Content="90 days" Tag="90"/>
                                        <ComboBoxItem Content="120 days" Tag="120"/>
                                        <ComboBoxItem Content="180 days" Tag="180"/>
                                    </ComboBox>
                                    <AppBarSeparator/>
                                    <AppBarButton x:Name="ScanStaleDevicesButton" Label="Scan" Click="ScanStaleDevicesButton_Click" ToolTipService.ToolTip="Find devices whose last activity is older than the threshold above.">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE721;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton x:Name="ClearSelectedStaleButton" Icon="Remove" Label="Clear Selected" Click="ClearSelectedStaleButton_Click" ToolTipService.ToolTip="Remove selected rows from the staging area."/>
                                    <AppBarButton x:Name="ClearAllStaleButton" Icon="Clear" Label="Clear All" Click="ClearAllStaleButton_Click" ToolTipService.ToolTip="Remove all rows from the staging area."/>
                                    <AppBarSeparator/>
                                    <AppBarButton x:Name="StaleDevicesClearLogButton" Icon="Delete" Label="Clear Log" Click="ClearLogButton_Click" ToolTipService.ToolTip="Clear the log console."/>
                                    <AppBarSeparator/>
                                    <AppBarButton x:Name="StaleDevicesExportCsvButton" Icon="Save" Label="Export CSV" Click="StaleDevicesExportCsvButton_Click" ToolTipService.ToolTip="Export the current grid contents to a CSV file."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Destructive Action"
                                           Style="{StaticResource CardSectionLabelTextBlockStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="DeleteStaleDevicesButton"
                                            Click="DeleteStaleDevicesButton_Click"
                                            ToolTipService.ToolTip="Permanently delete all staged devices."
                                            Style="{StaticResource DestructiveActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="White"/>
                                            <TextBlock Text="Delete All" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Stale Devices InfoBar -->
                    <InfoBar Grid.Row="1"
                             x:Name="StaleDevicesInfoBar"
                             IsOpen="True"
                             Severity="Warning"
                             Title="Staging Area — Read Before Deleting"
                             Message="Deleting an Intune device record removes it from management only — the device is not wiped or retired, and can re-enroll on its own. Deleting an Entra ID device object is recoverable for 30 days, but a hybrid-joined device will likely reappear via AD Connect sync unless it is also removed on-premises. 'Never synced' / 'Never signed in' devices may simply have stale activity data — review each device before deleting."
                             IsClosable="True"
                             Margin="0,0,12,12"/>

                    <!-- Intune Stale Devices DataGrid -->
                    <controls:DataGrid Grid.Row="2"
                                       x:Name="IntuneStaleDevicesDataGrid"
                                       Visibility="Visible"
                                       AutoGenerateColumns="False"
                                       SelectionMode="Extended"
                                       Margin="0,0,12,0"
                                       IsReadOnly="True"
                                       CanUserSortColumns="True"
                                       CanUserReorderColumns="False"
                                       Sorting="StaleDevicesDataGrid_Sorting">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="2*"/>
                            <controls:DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="*"/>
                            <controls:DataGridTextColumn Header="User" Binding="{Binding UserPrincipalName}" Width="*"/>
                            <controls:DataGridTextColumn Header="Compliance" Binding="{Binding ComplianceState}" Width="*"/>
                            <controls:DataGridTextColumn Header="Last Sync" Binding="{Binding LastSyncDisplay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Days Inactive" Binding="{Binding DaysInactiveDisplay}" Width="Auto"/>
                            <controls:DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="*"/>
                            <controls:DataGridTextColumn Header="ID" Binding="{Binding DeviceId}" Width="2*"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <!-- Entra Stale Devices DataGrid -->
                    <controls:DataGrid Grid.Row="2"
                                       x:Name="EntraStaleDevicesDataGrid"
                                       Visibility="Collapsed"
                                       AutoGenerateColumns="False"
                                       SelectionMode="Extended"
                                       Margin="0,0,12,0"
                                       IsReadOnly="True"
                                       CanUserSortColumns="True"
                                       CanUserReorderColumns="False"
                                       Sorting="StaleDevicesDataGrid_Sorting">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Device Name" Binding="{Binding DisplayName}" Width="2*"/>
                            <controls:DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="*"/>
                            <controls:DataGridTextColumn Header="OS Version" Binding="{Binding OperatingSystemVersion}" Width="*"/>
                            <controls:DataGridTextColumn Header="Join Type" Binding="{Binding JoinTypeDisplay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Enabled" Binding="{Binding EnabledDisplay}" Width="Auto"/>
                            <controls:DataGridTextColumn Header="Last Sign-In" Binding="{Binding LastSignInDisplay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Days Inactive" Binding="{Binding DaysInactiveDisplay}" Width="Auto"/>
                            <controls:DataGridTextColumn Header="ID" Binding="{Binding DeviceObjectId}" Width="2*"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <utilities:LoadingOverlay Grid.RowSpan="3" x:Name="StaleDevicesLoadingOverlay"/>
                </Grid>
            </Grid>

            <!-- Resizable Splitter -->
            <ctk:GridSplitter Grid.Column="1"
                              Width="8"
                              ResizeBehavior="BasedOnAlignment"
                              ResizeDirection="Columns"
                              Background="Transparent"/>

            <!-- Log Console Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Log Console"
                           Style="{StaticResource SidePanelHeaderTextBlockStyle}"/>
                <ListView Grid.Row="1"
                          x:Name="LogConsole"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource LogListViewItemContainerStyle}"
                          ItemTemplate="{StaticResource LogConsoleItemTemplate}"/>
            </Grid>
        </Grid>
    </Grid>
</utilities:BaseDataOperationPage>
