<Page
    x:Class="InToolz.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InToolz.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        2.0 Command Center dashboard — replaces HomePage. See design-concepts/
        concept-1-command-center.html for the visual reference. Landing page, not the
        three-row data layout, so (per docs/UI_STANDARD.md) it uses CardBorderStyle and
        the shared typography styles directly rather than the page header/toolbar/grid
        pattern other pages follow.
    -->
    <Grid Margin="{StaticResource PageRootMargin}">
        <ScrollViewer x:Name="PageScrollViewer">
            <StackPanel Spacing="24">

                <!-- ===== Hero banner ===== -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Welcome to InToolz"
                                   Style="{StaticResource PageTitleTextBlockStyle}"/>
                        <TextBlock Style="{StaticResource PageSubtitleTextBlockStyle}"
                                   MaxWidth="900">
                            Simplify bulk Intune management — assign, rename, clean up, and migrate configurations between tenants.
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,4,0,0">
                            <Ellipse x:Name="VersionStatusIndicator" Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="VersionStatusBrush" Color="Gray"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="VersionStatusText"
                                       Text="Checking version..."
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" x:Name="UpdateButtonsPanel" Visibility="Collapsed" Spacing="6">
                                <Button x:Name="OpenGitHubButton" Content="Open GitHub" Click="OpenGitHubButton_Click" VerticalAlignment="Center"/>
                                <Button x:Name="OpenStoreButton" Content="Open in Store" Click="OpenStoreButton_Click" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Stat tiles ===== -->
                <StackPanel>
                    <TextBlock Text="At a glance" Style="{StaticResource SidePanelHeaderTextBlockStyle}"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="UnassignedStatTile_Click" Style="{StaticResource FeatureCardButtonStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Unassigned items" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                                <TextBlock x:Name="UnassignedStatValueText" Text="—" Style="{StaticResource StatHeroValueTextBlockStyle}"/>
                                <TextBlock x:Name="UnassignedStatCaptionText" Text="Not yet scanned" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Click="StaleStatTile_Click" Style="{StaticResource FeatureCardButtonStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Stale devices" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                                <TextBlock x:Name="StaleStatValueText" Text="—" Style="{StaticResource StatHeroValueTextBlockStyle}"/>
                                <TextBlock x:Name="StaleStatCaptionText" Text="Not yet scanned" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Click="DuplicatesStatTile_Click" Style="{StaticResource FeatureCardButtonStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Duplicate names" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                                <TextBlock x:Name="DuplicatesStatValueText" Text="—" Style="{StaticResource StatHeroValueTextBlockStyle}"/>
                                <TextBlock x:Name="DuplicatesStatCaptionText" Text="Not yet scanned" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Click="ChangesStatTile_Click" Style="{StaticResource FeatureCardButtonStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Changes (7d)" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                                <TextBlock x:Name="ChangesStatValueText" Text="—" Style="{StaticResource StatHeroValueTextBlockStyle}"/>
                                <TextBlock x:Name="ChangesStatCaptionText" Text="Sign in to see activity" Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ===== Jump back in ===== -->
                <StackPanel>
                    <TextBlock Text="Jump back in" Style="{StaticResource SidePanelHeaderTextBlockStyle}"/>
                    <StackPanel x:Name="RecentActivityList" Spacing="8"/>
                    <TextBlock x:Name="RecentActivityEmptyText"
                               Text="Sign in via Settings to see recent tenant activity here."
                               Style="{StaticResource MutedCaptionTextBlockStyle}"/>
                </StackPanel>

                <!-- ===== Browse all actions ===== -->
                <StackPanel>
                    <TextBlock Text="Browse all actions" Style="{StaticResource SidePanelHeaderTextBlockStyle}"/>
                    <GridView x:Name="ActionsGridView"
                              IsItemClickEnabled="True"
                              ItemClick="ActionsGridView_ItemClick"
                              SelectionMode="None"
                              Padding="0"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,16,16"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Width="220" Height="150">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource FeatureCardTitleTextBlockStyle}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource FeatureCardDescriptionTextBlockStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- ===== Time saved ===== -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Time Saved" Style="{StaticResource SidePanelHeaderTextBlockStyle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                            <TextBlock x:Name="TimeSavedMinutesText" Text="0" Style="{StaticResource StatHeroValueTextBlockStyle}"/>
                            <TextBlock Text="minutes saved" Style="{StaticResource StatHeroLabelTextBlockStyle}"/>
                        </StackPanel>
                        <ProgressBar x:Name="TimeSavedProgress" Height="6" Minimum="0" Maximum="1000" Value="0" CornerRadius="3"/>
                        <TextBlock Text="Estimate based on recorded actions and typical manual completion times."
                                   TextWrapping="WrapWholeWords"
                                   Style="{StaticResource MutedCaptionTextBlockStyle}"/>

                        <StackPanel x:Name="TimeSavedBreakdownPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Breakdown" Style="{StaticResource SubsectionLabelTextBlockStyle}"/>
                            <StackPanel x:Name="RenamedItemsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="RenamedItemsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="items renamed / descriptions updated" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="AssignedItemsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="AssignedItemsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="items assigned" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="DeletedItemsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="DeletedItemsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="items deleted" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="ImportedItemsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="ImportedItemsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="items imported" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="CheckedAssignmentsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="CheckedAssignmentsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="items checked for assignments" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="JsonExportedItemsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="JsonExportedItemsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="items exported to JSON" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="AuditLogsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="AuditLogsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="audit logs retrieved" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="ManagedAssignmentsPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="ManagedAssignmentsCountText" Text="0" Style="{StaticResource StatBreakdownValueTextBlockStyle}"/>
                                <TextBlock Text="assignments managed" Style="{StaticResource StatBreakdownLabelTextBlockStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Resources ===== -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Resources" Style="{StaticResource SidePanelHeaderTextBlockStyle}" Margin="0"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE736;" FontSize="18" Opacity="0.7"/>
                                <TextBlock Text="Documentation" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="View on GitHub"
                                                 NavigateUri="https://github.com/Kvikku/InToolz"
                                                 Click="GitHubLink_Click"
                                                 VerticalAlignment="Center"
                                                 Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED15;" FontSize="18" Opacity="0.7"/>
                                <TextBlock Text="Feedback &amp; Issues" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Submit on GitHub"
                                                 NavigateUri="https://github.com/Kvikku/InToolz/issues"
                                                 Click="GitHubLink_Click"
                                                 VerticalAlignment="Center"
                                                 Padding="4,2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
