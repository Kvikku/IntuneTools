<Page
    x:Class="IntuneTools.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IntuneTools.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Migrated to the unified UI standard (see docs/UI_STANDARD.md).
        Settings is a special-case landing page (not the three-row data layout),
        so per the standard it adopts the shared title/subtitle typography tokens
        (PageTitleTextBlockStyle / PageSubtitleTextBlockStyle) and page spacing
        tokens such as PageRootMargin and PageHeaderBottomMargin.

        Content below the header is a grouped, scrollable settings list built on
        the WinUI Community Toolkit's SettingsCard/SettingsExpander controls —
        the same row pattern the native Windows 11 Settings app uses. New
        settings should be added as another SettingsCard inside an existing
        group's StackPanel, or as a new group (TextBlock label + StackPanel of
        cards) alongside "Tenants" and "Application" below.
    -->
    <Grid Margin="{StaticResource PageRootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Scrollable settings list -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderBottomMargin}">
            <TextBlock Text="Settings"
                       Style="{StaticResource PageTitleTextBlockStyle}"/>
            <TextBlock Text="Configure tenants and application preferences."
                       Style="{StaticResource PageSubtitleTextBlockStyle}"/>
        </StackPanel>

        <!-- ===== Settings list ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32" MaxWidth="900" HorizontalAlignment="Left" Padding="0,0,0,24">

                <!-- ===== Tenants group ===== -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Tenants"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>

                    <ctk:SettingsCard Header="Demo Mode"
                                      Description="No live tenant available? Load fictitious sample data into both Source and Destination so you can click through the app's pages without signing in anywhere.">
                        <Button x:Name="EnableDemoModeButton"
                                Content="Enable Demo Mode"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="EnableDemoModeButton_Click"/>
                    </ctk:SettingsCard>

                    <ctk:SettingsExpander Header="Source Tenant"
                                          Description="Used for Cleanup, Renaming, Assignment, and as the source when exporting content.">
                        <ctk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;"/>
                        </ctk:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image x:Name="SourceLoginStatusImage"
                                   Width="18"
                                   Height="18"
                                   Source="/Assets/RedCross.png"/>
                            <TextBlock x:Name="SourceLoginStatusText"
                                       Text="Not signed in"
                                       VerticalAlignment="Center"
                                       Opacity="0.8"/>
                        </StackPanel>
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard Header="Sign in" Description="Authenticate to the source tenant.">
                                <Button x:Name="SourceLoginButton"
                                        Content="Login"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Click="SourceLoginButton_Click"/>
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Session" Description="Clear the cached sign-in token for this tenant.">
                                <Button x:Name="SourceClearTokenButton"
                                        Content="Clear Token"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="SourceClearTokenButton_Click"/>
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Permissions" Description="View granted vs. required Graph permissions.">
                                <Button x:Name="SourceViewPermissionsButton"
                                        Content="View Permissions"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="SourceViewPermissionsButton_Click"/>
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>

                    <ctk:SettingsExpander Header="Destination Tenant"
                                          Description="Used only as the destination when importing content.">
                        <ctk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;"/>
                        </ctk:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image x:Name="DestinationLoginStatusImage"
                                   Width="18"
                                   Height="18"
                                   Source="/Assets/RedCross.png"/>
                            <TextBlock x:Name="DestinationLoginStatusText"
                                       Text="Not signed in"
                                       VerticalAlignment="Center"
                                       Opacity="0.8"/>
                        </StackPanel>
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard Header="Sign in" Description="Authenticate to the destination tenant.">
                                <Button x:Name="DestinationLoginButton"
                                        Content="Login"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Click="DestinationLoginButton_Click"/>
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Session" Description="Clear the cached sign-in token for this tenant.">
                                <Button x:Name="DestinationClearTokenButton"
                                        Content="Clear Token"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="DestinationClearTokenButton_Click"/>
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Permissions" Description="View granted vs. required Graph permissions.">
                                <Button x:Name="DestinationViewPermissionsButton"
                                        Content="View Permissions"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="DestinationViewPermissionsButton_Click"/>
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>

                    <ctk:SettingsCard Header="Swap Tenants"
                                      Description="Swap the source and destination tenant credentials — useful if you signed into the wrong one.">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8AB;"/>
                        </ctk:SettingsCard.HeaderIcon>
                        <Button x:Name="SwapTenantsButton"
                                Content="Swap"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Click="SwapTenantsButton_Click"/>
                    </ctk:SettingsCard>
                </StackPanel>

                <!-- ===== Application group =====
                     Home for app-level (non-tenant) settings. Add future
                     preferences here as additional SettingsCards. -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Application"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>

                    <ctk:SettingsCard Header="Log Files"
                                      Description="Open the folder containing this session's log files.">
                        <Button Content="Open Log File Location"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Click="OpenLogFileLocation_Click"/>
                    </ctk:SettingsCard>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
